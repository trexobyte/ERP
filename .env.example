# ------------------------------------------------------------------------------
# TrexoByte ERP — Environment Configuration Template
# Copy this file to `.env` or `.env.local` for local development.
# In production, set these variables in your deployment dashboard (Vercel/Railway).
# ------------------------------------------------------------------------------

# 1. DATABASE (PostgreSQL / Neon / Supabase)
# Pooled connection string (with ?pgbouncer=true if using PgBouncer/Supabase pooler)
DATABASE_URL="postgresql://postgres:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/trexobyte?pgbouncer=true"

# Direct connection string (bypasses connection pooler for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@ep-sample.ap-southeast-1.aws.neon.tech/trexobyte"

# 2. AUTHENTICATION (NextAuth.js)
# Required in production. Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-32-byte-base64-random-secret"

# Canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"

# 3. SECURITY GATES
# When set to 'true', permits the development fallback password ('password123') in non-production.
# This flag is strictly IGNORED when NODE_ENV === 'production'.
ALLOW_DEV_PASSWORD_FALLBACK="false"

# When set to 'true', shows quick-fill demo staff account buttons on the login screen.
# Defaults to true in development, false in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# 4. DISTRIBUTED CACHE (Optional — Upstash Redis REST)
# Decouples API cache across multi-instance serverless deployments (Vercel / AWS Lambda).
# If left blank, the application automatically uses an in-memory cache store.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
